# ===== Modo de execução =====
# PROXY=1  → modo homelab: só HTTP interno, o CloudPanel/Nginx faz o SSL.
# (sem PROXY) → modo local: HTTP + HTTPS autoassinado, uso na mesma rede.
PROXY=1

# Porta interna que o Node escuta (o CloudPanel faz o proxy pra cá)
PORT=3000

# URL pública do app (só para as mensagens de log)
APP_URL=https://audio.seudominio.com

# ===== Segurança =====
# Token de acesso OBRIGATÓRIO quando exposto na internet.
# Gere um forte, ex.:  openssl rand -hex 24
ACCESS_TOKEN=troque-por-um-token-bem-grande

# ===== STUN / TURN (coturn) =====
# STUN público (descoberta de IP). Pode manter o do Google.
STUN_URL=stun:stun.l.google.com:19302

# TURN (relê o áudio quando o NAT bloqueia — necessário no 4G/5G).
# Use o MESMO domínio e o MESMO segredo do turnserver.conf (static-auth-secret).
TURN_HOST=turn.seudominio.com
TURN_SECRET=troque-por-outro-segredo-forte
TURN_REALM=turn.seudominio.com
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_TTL=3600
